# Copy this file to .env and replace the Atlas URI with your own.
# Do not submit a .env file containing your real password.
ATLAS_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
DOCKER_URI=mongodb://localhost:27017
# Activity 2.2 uses Docker by default. Set this to Atlas only if desired:
MONGODB_URI=mongodb://localhost:27017
