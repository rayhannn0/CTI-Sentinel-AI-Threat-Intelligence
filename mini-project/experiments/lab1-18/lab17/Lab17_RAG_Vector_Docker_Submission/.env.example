# Default is local MongoDB (works offline with client-side search).
# To use MongoDB Atlas: configure a reachable mongodb+srv:// connection string
# MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER/?retryWrites=true&w=majority
# Optional embeddings and LLM:
# VOYAGE_API_KEY=
# OPENAI_API_KEY=
ATLAS_VECTOR_INDEX=threat_vector_index
